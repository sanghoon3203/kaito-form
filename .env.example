# public/ フォルダの一つ上に .env という名前で置く(公開フォルダには置かない)
# Apps Script をウェブアプリとしてデプロイしたときの URL(.../exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Apps Script の Script Properties「SHARED_SECRET」と同じ値(長いランダム文字列)
SHARED_SECRET=change-me
# Cloudflare Turnstile のサイトキーとシークレットキー。ウィジェットのホスト名に PHP サーバーのドメインを追加すること
TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET=0x0000000000000000000000000000000000
