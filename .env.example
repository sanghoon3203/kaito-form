# public/ フォルダの一つ上に .env という名前で置く(公開フォルダには置かない)
# Apps Script をウェブアプリとしてデプロイしたときの URL(.../exec)
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# Apps Script の Script Properties「SHARED_SECRET」と同じ値(長いランダム文字列)。フォームのトークンの署名にも使う
SHARED_SECRET=change-me
# 以下は省略可
# 送信回数の記録と使用済みトークンを置く場所(PHP が書き込めること)。省略すると public の一つ上の data/
# DATA_DIR=/home/example/kaito-form-data
# 同じ IP アドレスから1時間に送信できる回数
# RATE_LIMIT_PER_HOUR=5
# フォーム表示から送信までの最短秒数(これより早い送信はボットとみなす)
# MIN_FORM_SECONDS=3
